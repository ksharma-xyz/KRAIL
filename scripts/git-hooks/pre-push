#!/bin/sh
# Structural checks first: a failure here aborts the push before git-lfs uploads anything.
# Versioned at scripts/git-hooks/pre-push and copied into .git/hooks by
# scripts/install_git_hooks.sh. Edit the versioned copy, not the installed one.
if [ -x "$(git rev-parse --show-toplevel)/scripts/pre_push_structural_checks.sh" ]; then
  "$(git rev-parse --show-toplevel)/scripts/pre_push_structural_checks.sh" || exit 1
fi

# git-lfs pre-push, preserved from the default install. Do not remove: this repo stores
# screenshots in LFS and dropping this silently pushes pointers without their objects.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"
